# AI Assistant
# The assistant works WITHOUT any key: it searches a local vector index of verified
# company knowledge and composes answers itself (retrieval mode).
# Set OPENAI_API_KEY to add natural-language generation on top of the same retrieval.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Transformer-based semantic embeddings (primary retrieval).
# Leave EMBEDDING_API_KEY empty to use the local hashed-feature fallback.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Optional: override for an OpenAI-compatible provider.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=1536
# Retrieval tuning
RAG_TOP_K=5
EMBEDDING_MIN_SCORE=0.22

# Admin authentication (session cookie)
ADMIN_USERNAME=admin
# Generate a hash with: npm run hash-admin-password -- <plaintext-password>
ADMIN_PASSWORD_HASH=
# Session TTL in milliseconds for admin console sessions (default: 30 min)
ADALIA_ADMIN_SESSION_TTL_MS=1800000
# Force Secure cookie flag (enable when serving behind HTTPS; harmless on localhost)
ADALIA_FORCE_COOKIE_SECURE=1

# Optional: directory for all persisted data (settings store, admin sessions,
# uploaded documents). Defaults to <app>/data. On Render set this to the
# Managed Disk mount path (see RENDER_DEPLOYMENT_GUIDE.md).
ADALIA_DATA_DIR=

# Optional: directory for uploaded documents (certificates, HSE policies,
# project photos). Defaults to $ADALIA_DATA_DIR/documents.
ADALIA_DOCUMENTS_DIR=

# Legacy: protected knowledge-management endpoint — deprecated in favour of
# the session-based admin console. Leave unset.
ADMIN_KNOWLEDGE_TOKEN=

# Enquiry delivery
CONTACT_TO_EMAIL=benscottlove816@gmail.com
# MUST BE VERIFIED BY ADALIA OIL AND GAS LTD BEFORE PUBLICATION
WHATSAPP_NUMBER=08133744562

# SMTP delivery (recommended for production; use an App Password for Gmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp Cloud API (optional; the contact form also offers a WhatsApp link)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Public site URL (used in metadata, sitemap, robots, OG).
# For production on Render, set this to the custom domain (e.g. https://adaliaoilandgasltd.com)
# — see RENDER_DEPLOYMENT_GUIDE.md.
NEXT_PUBLIC_SITE_URL=http://www.adaliaoilandgasltd.com

# Testing only: password used by scripts/admin-test.mjs against the admin console
ADALIA_TEST_PASSWORD=TestAdminPass123
